# ─────────────────────────────────────────────────────────────
# LLM Provider Configuration
# ─────────────────────────────────────────────────────────────
# Active provider: "gemini" (default), "groq", or "openai_compatible"
LLM_PROVIDER=gemini

# ─────────────────────────────────────────────────────────────
# Option A: Google Gemini (Default)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Optional model override (defaults to gemini-3.5-flash with flash-lite fallback)
GEMINI_MODEL=gemini-3.5-flash

# ─────────────────────────────────────────────────────────────
# Option B: Groq (Fast OpenAI-Compatible Inference)
# ─────────────────────────────────────────────────────────────
# To use Groq: set LLM_PROVIDER=groq and provide your GROQ_API_KEY
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# ─────────────────────────────────────────────────────────────
# Option C: Any Other OpenAI-Compatible API
# ─────────────────────────────────────────────────────────────
# To use an OpenAI-compatible endpoint: set LLM_PROVIDER=openai_compatible
# OPENAI_API_KEY=your_openai_or_compatible_key_here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
